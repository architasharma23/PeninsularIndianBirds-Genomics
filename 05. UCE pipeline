conda activate phyluce-1.7.3

# example pipleline with one species  - PS (Purple Sunbird)
phyluce_assembly_match_contigs_to_probes \
    --contigs 06_contigs_by_species/PS \
    --probes uce-5k-probes.fasta \
    --output 06_contigs_by_species/PS/07_uce_search_results

repeated for RT, RVB, ZOPA, PYJO, BTM, GRTD

#how to create taxon-set.conf > do ls to get list of files > then do this - for example
cat > taxon-set.conf <<'EOF'
[all]
C_a_asiaticus_PS_LAMASINGHI2018
C_a_asiaticus_Z0033
C_a_asiaticus_Z4615
C_a_asiaticus_Z4636
C_a_asiaticus_Z4828
C_a_asiaticus_Z4900
C_a_asiaticus_Z7612
C_a_asiaticus_Z7972
C_a_intermedius_Z7522
C_a_intermedius_Z7796
C_regius_SRR13069960
C_unknown_PS_LAMASINGHI2022
EOFcd

#make the directory to run next steps
mkdir - p taxon_sets/all/

phyluce_assembly_get_match_counts \
    --locus-db 07_uce_search_results/probe.matches.sqlite \
    --taxon-list-config taxon-set.conf \
    --taxon-group all \
    --incomplete-matrix \
    --output taxon_sets/all/all-taxa-incomplete.conf

cd taxon_sets/all/
mkdir log

phyluce_assembly_get_fastas_from_match_counts \
    --contigs ../../ \
    --locus-db ../../07_uce_search_results/probe.matches.sqlite \
    --match-count-output all-taxa-incomplete.conf \
    --output all-taxa-incomplete.fasta \
    --incomplete-matrix all-taxa-incomplete.incomplete \
    --log-path log

phyluce_assembly_explode_get_fastas_file \
    --input all-taxa-incomplete.fasta \
    --output exploded-fastas \
    --by-taxon

# get summary stats on the FASTAS
for i in exploded-fastas/*.fasta;
do
    phyluce_assembly_get_fasta_lengths --input $i --csv;
done

# align the data - edit the taxa count
phyluce_align_seqcap_align \
    --input all-taxa-incomplete.fasta \
    --output mafft-nexus-edge-trimmed \
    --taxa 4 \
    --aligner mafft \
    --cores 12 \
    --incomplete-matrix \
    --log-path log

phyluce_align_remove_locus_name_from_files \
    --alignments mafft-nexus-edge-trimmed \
    --output mafft-nexus-edge-trimmed-clean \
    --cores 12 \
    --log-path log

phyluce_align_get_only_loci_with_min_taxa \
    --alignments mafft-nexus-edge-trimmed-clean \
    --taxa 12 \
    --percent 0.75 \
    --output mafft-nexus-edge-trimmed-clean-75p \
    --cores 12 \
    --log-path log

phyluce_align_concatenate_alignments \
    --alignments mafft-nexus-edge-trimmed-clean-75p \
    --output mafft-nexus-edge-trimmed-clean-75p-raxml \
    --phylip \
    --log-path log

#when you are inside the phylip direc - for example - PS/taxon_sets/all/mafft-nexus-edge-trimmed-clean-75p-raxml/
nohup iqtree2 \
    -s mafft-nexus-edge-trimmed-clean-75p-raxml.phylip \
    -m MFP \
    -B 1000 \
    --alrt 1000 \
    -T 8 \
    --prefix ../../../../iqtree_results/PS_unpartitioned \
    > ../../../../iqtree_results/PS_unpartitioned_nohup.log 2>&1 &

nohup iqtree2 \
    -s mafft-nexus-edge-trimmed-clean-75p-raxml.phylip \
    -p mafft-nexus-edge-trimmed-clean-75p-raxml.charsets \
    -m MFP+MERGE \
    -B 1000 \
    --alrt 1000 \
    -T 8 \
    --prefix ../../../../iqtree_results/PS_partitioned \
    > ../../../../iqtree_results/PS_partitioned_nohup.log 2>&1 &

